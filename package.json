{
  "name": "zemrev-backend",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Zemrev Microservices Backend",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json}\"",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml build",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker-compose -f docker-compose.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.yml down",
    "docker:prod:build": "docker-compose -f docker-compose.yml build",
    "docker:prod:logs": "docker-compose -f docker-compose.yml logs -f",
    "docker:dev:rebuild": "docker-compose -f docker-compose.dev.yml build --no-cache && docker-compose -f docker-compose.dev.yml up -d",
    "docker:prod:rebuild": "docker-compose -f docker-compose.yml build --no-cache && docker-compose -f docker-compose.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3"
  }
}